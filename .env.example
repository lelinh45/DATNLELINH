# === Sao chép file này thành .env và điền giá trị thật — KHÔNG commit .env ===

# RPC endpoint của mạng Sepolia (server dùng để đọc contract)
RPC_URL=https://rpc.sepolia.org
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Private key ví deploy — scripts/deploy.js dùng để deploy contract,
# server dùng để ký giao dịch cho API đối tác. Tuyệt đối không đưa vào frontend
PRIVATE_KEY=

# Địa chỉ contract DataIntegrity sau khi deploy (deploy.js tự điền)
CONTRACT_ADDRESS=

# Pinata IPFS — chỉ dùng phía server (/api/upload)
PINATA_API_KEY=
PINATA_API_SECRET=

# Gemini AI — phân tích forensic khi phát hiện giả mạo
GEMINI_API_KEY=

# JWT — khóa ký token đăng nhập (BẮT BUỘC, sinh chuỗi ngẫu nhiên dài >= 32 ký tự)
# VD sinh nhanh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# MongoDB (mặc định local)
MONGO_URI=mongodb://localhost:27017/DataIntegrity

# Cổng server (mặc định 3000)
PORT=3000

# Danh sách origin được phép gọi API, phân tách bằng dấu phẩy.
# Để trống = chỉ cho phép localhost/127.0.0.1 mọi port + file:// (dev).
# VD production: CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# Khóa bọc AES key của file trong MongoDB (key escrow).
# Để trống → dùng JWT_SECRET. Đổi MASTER_KEY sau khi đã lưu key thì không giải được key cũ.
MASTER_KEY=

# SMTP — gửi mã OTP duyệt thiết bị mới về email chủ ví.
# Gmail: bật 2FA rồi tạo "App password" (myaccount.google.com/apppasswords)
# Để trống SMTP_USER → tính năng OTP email tắt (thiết bị mới chỉ duyệt được từ thiết bị cũ).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
OTP_FROM=
