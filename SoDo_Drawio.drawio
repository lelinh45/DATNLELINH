<mxCell id="c6063" value="Quan hệ logic qua trường dữ liệu — MongoDB không có khóa ngoại vật lý.&lt;br&gt;refDocId trỏ tới docId của bản ghi gốc khi đối tác dùng chung một bằng chứng on-chain.&lt;br&gt;files[] là mảng document NHÚNG trong batches (nét đứt)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="380" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram>
